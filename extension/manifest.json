{
  "manifest_version": 3,
  "default_locale": "es",
  "name": "__MSG_extensionName__",
  "short_name": "Lossy",
  "version": "1.6.1",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/core/canonical/canonical_schema.js",
        "src/core/canonical_model.js",
        "src/core/portability/zip_builder.js",
        "src/core/portability/pdf_builder.js",
        "src/core/portability/docx_builder.js",
        "src/core/portability/export_center.js",
        "src/core/i18n/en_strings.js",
        "src/core/i18n/translator.js",
        "src/platforms/chatgpt/chatgpt_assets.js",
        "src/platforms/chatgpt/structured/chatgpt_structured_acquisition.js",
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://files.oaiusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/workspace/workspace.html",
        "src/workspace/workspace.css",
        "src/workspace/workspace.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}
